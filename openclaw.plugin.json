{
  "id": "gigachat",
  "name": "GigaChat Provider",
  "description": "GigaChat models for OpenClaw. OAuth, Russian Trusted CA, and an embedded OpenAI-compatible bridge with tools support.",
  "categories": ["models"],
  "activation": {
    "onStartup": true
  },
  "providers": ["gigachat"],
  "contracts": {
    "usageProviders": []
  },
  "modelCatalog": {
    "providers": {
      "gigachat": {
        "baseUrl": "http://127.0.0.1:18080/v1",
        "api": "openai-completions",
        "defaultModel": "GigaChat-3-Ultra",
        "models": [
          {
            "id": "GigaChat-3-Ultra",
            "name": "GigaChat 3 Ultra",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "compat": {
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            }
          },
          {
            "id": "GigaChat-2-Max",
            "name": "GigaChat 2 Max",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "compat": {
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            }
          },
          {
            "id": "GigaChat-2-Pro",
            "name": "GigaChat 2 Pro",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "compat": {
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            }
          },
          {
            "id": "GigaChat-2",
            "name": "GigaChat 2 Lite",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "compat": {
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            }
          }
        ]
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "gigachat",
        "envVars": ["GIGACHAT_AUTH_KEY"]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "port": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535,
        "default": 18080,
        "description": "Local bridge port on 127.0.0.1. Must match models.providers.gigachat.baseUrl."
      },
      "localToken": {
        "type": "string",
        "default": "gigachat-local",
        "description": "Expected Bearer token on the local bridge. Kept in models.providers.gigachat.apiKey."
      },
      "authKey": {
        "type": "string",
        "description": "GigaChat authorization key from developers.sber.ru (ready Base64 key or ClientID:ClientSecret)."
      },
      "clientId": {
        "type": "string",
        "description": "GigaChat Client ID. Used together with clientSecret when authKey is not set."
      },
      "clientSecret": {
        "type": "string",
        "description": "GigaChat Client Secret. Used together with clientId when authKey is not set."
      },
      "scope": {
        "type": "string",
        "default": "GIGACHAT_API_PERS",
        "description": "GigaChat OAuth scope. GIGACHAT_API_PERS is the free personal tier."
      },
      "apiBaseUrl": {
        "type": "string",
        "default": "https://api.giga.chat/v1",
        "description": "GigaChat API base URL."
      },
      "oauthUrl": {
        "type": "string",
        "default": "https://ngw.devices.sberbank.ru:9443/api/v2/oauth",
        "description": "GigaChat OAuth token endpoint."
      },
      "caFile": {
        "type": "string",
        "description": "Optional path to an extra CA bundle (PEM). Bundled Russian Trusted Root/Sub CA are always used."
      },
      "maxContextTokens": {
        "type": "integer",
        "minimum": 1024,
        "default": 128000,
        "description": "Context window advertised for all GigaChat models."
      }
    }
  }
}
